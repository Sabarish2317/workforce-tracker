# Copy to .env.local for local dev. On Vercel, set these in
# Project → Settings → Environment Variables.

# Supabase Postgres connection string. In Supabase: Connect → "Transaction pooler"
# (port 6543). Server-side only: never expose this to the browser or the app.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Signs login tokens. Use a random string of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production with this placeholder.
JWT_SECRET=dev-insecure-secret-change-me

# How long a login token stays valid.
TOKEN_TTL=7d

# Bump whenever the workforce-monitoring policy text changes; workers must
# re-acknowledge before they can go on duty again.
POLICY_VERSION=2026-11-v2
